{
  "version": "{{VERSION}}",
  "description": "Cross-platform game mod manager",
  "homepage": "https://modde.tartanoglu.com",
  "license": "GPL-3.0-only",
  "url": "https://github.com/caniko/rs-modde/releases/download/{{VERSION}}/modde-{{VERSION}}-x86_64-windows.zip",
  "hash": "{{SHA256}}",
  "bin": [
    "modde.exe",
    "modde-ui.exe"
  ],
  "checkver": {
    "url": "https://github.com/caniko/rs-modde/releases",
    "regex": "tag/([\\d.]+)"
